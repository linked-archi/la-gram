# Dependencies
node_modules/

# Build output (webpack writes dist/web, dist/electron with clean: true)
dist/
build/

# la-gram-git's package: what the build copies in beside its dist/
packages/la-gram-git/assets/
packages/la-gram-git/ci/
packages/la-gram-git/LICENSE
packages/la-gram-git/*.tgz

# Test / coverage output
coverage/
.vitest/
.vite/

# Browser smoke suite artefacts (screenshots land in test-results/browser/)
# and Playwright's own output directories.
test-results/
playwright-report/
blob-report/
.playwright/

# TypeScript incremental build info
*.tsbuildinfo

# Python bytecode: MkDocs imports scripts/docs' hooks
__pycache__/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / local overrides
.env
.env.*
!.env.example
..local

# Editors and IDEs
.idea/
*.iml
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS cruft
.DS_Store
Thumbs.db

# Scratch / temp
tmp/
temp/
~*

# Electron packaging output
release/
out/

# Collaboration server working state (see server/collab-server.mjs)
data/
# Docs build venv, and agents' task folders — ignored except for shared plans explicitly included.
# The specs and conventions under .agents/ are tracked (.kiro/ links to them, for Kiro).
.venv-docs/
.agents/tasks/*
!.agents/tasks/git-sync/
!.agents/tasks/github-move/
!.agents/tasks/kernel-migration/
!.agents/tasks/pull-deploy/
!.agents/tasks/view-references/
!.agents/tasks/views-as-concepts/

# Ours deletes CRM; theirs places it on the diagram. A conflict: the merged
# model keeps CRM, placed; ours' option deletes CRM and the new node.

@prefix m:      <https://example.org/m/> .
@prefix ex:     <https://example.org/vocab#> .
@prefix arch:   <https://meta.linked.archi/core#> .
@prefix vis:    <https://meta.linked.archi/core-vis#> .
@prefix am4:    <https://meta.linked.archi/archimate4/onto#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .

<urn:ours-removed> {
    m:crm a am4:ApplicationComponent ;
        skos:prefLabel "CRM"@en ;
        arch:inModel m:model .
}
<urn:theirs-added> {
    m:crm arch:inView m:view .
    m:node-crm a vis:ArchNode ;
        vis:view m:view ;
        vis:archElement m:crm ;
        vis:bounds-x "600"^^xsd:double ; vis:bounds-y "0"^^xsd:double ;
        vis:bounds-w "120"^^xsd:double ; vis:bounds-h "55"^^xsd:double .
}

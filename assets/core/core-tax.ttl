@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix :        <https://meta.linked.archi/core/tax#> .

#################################################################
# Concept Scheme
#################################################################

<https://meta.linked.archi/core/tax#>
    a                             skos:ConceptScheme ;
    skos:prefLabel                "Linked.Archi Core Concept Scheme"@en ;
    dcterms:title                 "Linked.Archi Core Taxonomy"@en ;
    dcterms:description           '''Classification of the core concepts a model may use directly: the
generic element and the generic relationship. A language's own taxonomy classifies
its specific types; this one names the core's, so that a palette offers them only
when the core metamodel is chosen.'''@en ;
    skos:hasTopConcept            :CoreConcepts ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/core/tax#" ;
    vann:preferredNamespacePrefix "archtax" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:created               "2026-09-28"^^xsd:date ;
.

#################################################################
# Axis and group
#################################################################

:CoreConcepts
    a                 skos:Concept ;
    skos:prefLabel    "Core Concepts"@en ;
    skos:definition   "The core ontology's concepts, by kind."@en ;
    skos:topConceptOf <https://meta.linked.archi/core/tax#> ;
    skos:inScheme     <https://meta.linked.archi/core/tax#> ;
    skos:narrower     :Generic ;
.

:Generic
    a               skos:Concept ;
    skos:prefLabel  "Generic"@en ;
    skos:definition "An element or a relationship of no more specific type."@en ;
    skos:scopeNote  '''Use them for what the loaded languages do not define, or before deciding
which specific type something is. A generic relationship may connect any two model
concepts: no language's relationship rules constrain it. Between two elements of a
language, the connection's type can later be changed to one of that language's.'''@en ;
    skos:broader    :CoreConcepts ;
    skos:inScheme   <https://meta.linked.archi/core/tax#> ;
    skos:narrower   :Element, :Relationship ;
.

#################################################################
# Members — terminal concepts naming the core classes
#################################################################

:Element
    a               skos:Concept ;
    skos:prefLabel  "Element"@en ;
    skos:definition "Any significant component of the architecture, of no more specific type."@en ;
    rdfs:seeAlso    arch:Element ;
    skos:broader    :Generic ;
    skos:inScheme   <https://meta.linked.archi/core/tax#> ;
.

:Relationship
    a               skos:Concept ;
    skos:prefLabel  "Relationship"@en ;
    skos:definition "A qualified relationship between two model concepts, of no more specific type."@en ;
    rdfs:seeAlso    arch:QualifiedRelationship ;
    skos:broader    :Generic ;
    skos:inScheme   <https://meta.linked.archi/core/tax#> ;
.

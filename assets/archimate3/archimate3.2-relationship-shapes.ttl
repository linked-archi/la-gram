    dcterms:title                 "Linked.Archi ArchiMate 3.2 SHACL Shapes"@en ;
    dcterms:description           '''SHACL shapes for validating ArchiMate 3.2 model data. Generated from the
ArchiMate relationship validity matrix (Archi tool, MIT license). Validates both qualified
relationship instances and unqualified direct triples. Pure SHACL core — no SPARQL.'''@en ;
    dcterms:created               "2019-03-17"^^xsd:date ;
    dcterms:modified              "2026-05-18"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;

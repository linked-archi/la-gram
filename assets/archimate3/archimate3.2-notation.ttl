@prefix :         <https://meta.linked.archi/archimate3/notation#> .

<https://meta.linked.archi/archimate3/notation#>
    rdf:type                      owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-vis#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate3/notation#" ;
    vann:preferredNamespacePrefix "archimate3not" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi ArchiMate 3.2 Visual Notation Set"@en ;
    dcterms:description                '''Visual notation descriptors for ArchiMate 3.2 elements
and relationships. Defines the standard visual appearance (shape, color, icon,
line style) for each model concept, enabling palette generation and diagram
rendering from structured metadata.'''@en ;
    dcterms:created               "2026-05-16"^^xsd:date ;
    dcterms:modified              "2026-10-08"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/archimate3/notation/3.2#> ;
    owl:versionInfo               "3.2"@en ;
.


#################################################################
# Notation Set
#################################################################

:ArchiMate32StandardNotation
    a               arch-vis:NotationSet ;
    skos:prefLabel  "ArchiMate 3.2 Standard Notation"@en ;
    skos:definition "The standard visual notation defined by the ArchiMate 3.2 specification."@en ;
.

## ─────────────────────────────────────────────────────────────────
## NOTE: Icon URIs (arch:prefVisNotation, arch-vis:iconSymbol) reference
## the published site at https://meta.linked.archi/archimate3/icons/...
## The source SVG files live in modelingLanguages/archimate/3.2/icons/
## and are deployed to those URLs by the CI pipeline (pages job).
## For local/offline use, resolve https://meta.linked.archi/ to the repo root.
## ─────────────────────────────────────────────────────────────────


#################################################################
# Element Visual Notations
#################################################################

:StakeholderNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor am:Stakeholder ;
    arch-vis:inNotationSet :ArchiMate32StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/archimate3/icons/stakeholder.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:shapeType     arch-vis:Octagon ;
        arch-vis:fillColor     "#CBCBFF" ;
        arch-vis:lineColor     "#000000" ;
        arch-vis:renderingMode arch-vis:ShapeWithBadge ;
        arch-vis:iconSymbol    "https://meta.linked.archi/archimate3/icons/glyphs/stakeholder.svg"^^xsd:anyURI ;
        arch-vis:iconPlacement arch-vis:TopRight ;
        arch-vis:defaultWidth  120.0 ;
        arch-vis:defaultHeight 55.0 ;
    ] ;
.


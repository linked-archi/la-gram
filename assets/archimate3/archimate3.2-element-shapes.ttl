        sh:prefix "am" ;
        sh:namespace "https://meta.linked.archi/archimate3/onto#"^^xsd:anyURI ;
    ] , [
        sh:prefix "arch" ;
        sh:namespace "https://meta.linked.archi/core#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string .


#################################################################
# 1. Element instance requirements — the authoritative ArchiMate 3.2 naming rule
#
# core-shapes carries no label shape. arch:Element means "a node in a model", and
# some notations have nodes that are legitimately unnamed, so naming policy is
# owned by each metamodel. See DD-24 in doc/guide/design-decisions.md.
#
# Targets the 7 abstract layer and aspect roots rather than arch:Element. Two
# reasons:
#
#  1. Junctions are excluded. am:Junction_And and am:Junction_Or are declared
#     rdfs:subClassOf arch:Element directly, outside these 7 roots, so they are not
#     reached. Junctions are genuine elements — they have identity and render as
#     dots or bars on a view — but ArchiMate uses them as relationship connectors
#     and they are conventionally unnamed. Requiring a label on them would be
#     wrong.
#
#  2. Targeting arch:Element would leak. In a merged multi-notation graph it would
#     impose ArchiMate's naming policy on BPMN, C4 and every other notation's
#     elements. A metamodel constrains only its own classes.
#
# Coverage: these roots reach 80 of the 82 am arch:Element classes, the 2
# remaining being the junctions.
#################################################################

:ArchiMateElementShape
    a              sh:NodeShape ;
    rdfs:comment   '''Requires a language-tagged skos:prefLabel on every ArchiMate 3.2 element
except junctions. Targets the abstract layer and aspect roots, not arch:Element, so that
am:Junction_And and am:Junction_Or stay exempt and the rule cannot leak onto other notations
in a merged graph.'''@en ;
    sh:targetClass am:CoreLayerElement ,
                   am:StrategyLayerElement ,
                   am:ImplementationAndMigrationLayerElement ,
                   am:MotivationElement ,
                   am:BehaviorElement ,
                   am:StructureElement ,
                   am:CompositeElement ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     '''Every ArchiMate element instance must have at least one
skos:prefLabel, and it must be language-tagged (rdf:langString), e.g. "Billing"@en. Junctions
are exempt — they are connectors and are conventionally unnamed.'''@en ;
    ] ;
.

#################################################################
# 2. Structural integrity — self-loops and cycles
#################################################################

:NoSelfCompositionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:composedOf ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "An element cannot compose itself."@en ;
        sh:select """
            SELECT $this WHERE { $this am:composedOf $this . }
        """ ;
    ] ;
.

:NoSelfAggregationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:aggregates ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "An element cannot aggregate itself."@en ;
        sh:select """
            SELECT $this WHERE { $this am:aggregates $this . }
        """ ;
    ] ;
.

:NoSelfSpecializationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "An element cannot specialize itself."@en ;
        sh:select """
            SELECT $this WHERE { $this am:specializes $this . }
        """ ;
    ] ;
.

:NoCircularCompositionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:composedOf ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Circular composition is not allowed."@en ;
        sh:select """
            SELECT $this WHERE { $this am:composedOf+ $this . }
        """ ;
    ] ;
.

:NoCircularAggregationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:aggregates ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Circular aggregation is not allowed."@en ;
        sh:select """
            SELECT $this WHERE { $this am:aggregates+ $this . }
        """ ;
    ] ;
.

:CompositionPartUniquenessShape
    a sh:NodeShape ;
    sh:targetObjectsOf am:composedOf ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "A composed part can only belong to one whole (composition implies exclusive ownership)."@en ;
        sh:select """
            SELECT $this WHERE {
                ?whole1 am:composedOf $this .
                ?whole2 am:composedOf $this .
                FILTER(?whole1 != ?whole2)
            }
        """ ;
    ] ;
.

#################################################################
# 3. Specialization same-type constraint
#################################################################

:SpecializationSameTypeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Specialization must connect elements of the same ArchiMate type."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:specializes ?target .
                $this rdf:type ?sourceType .
                ?target rdf:type ?targetType .
                ?sourceType rdfs:subClassOf* arch:Element .
                ?targetType rdfs:subClassOf* arch:Element .
                FILTER NOT EXISTS {
                    $this rdf:type ?commonType .
                    ?target rdf:type ?commonType .
                    ?commonType rdfs:subClassOf* arch:Element .
                }
            }
        """ ;
    ] ;
.


#################################################################
# 4. Generic Metamodel — Figure 5 (core layers only)
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Generic-Metamodel.html
#################################################################

## A1: Assignment: ActiveStructure → BehaviorAspect
:AssignmentSourceConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, assignment can only originate from active structure elements."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:assignedTo ?target .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:ActiveStructureElement .
                }
            }
        """ ;
    ] ;
.

:AssignmentTargetConstraint
    a sh:NodeShape ;
    sh:targetObjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, assignment can only target behavior elements."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:assignedTo $this .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:BehaviorElement .
                }
            }
        """ ;
    ] ;
.

## A2: Access: BehaviorAspect → PassiveStructure
:AccessSourceConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf am:accesses ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, access can only originate from behavior elements."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:accesses ?target .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:BehaviorElement .
                }
            }
        """ ;
    ] ;
.

:AccessTargetConstraint
    a sh:NodeShape ;
    sh:targetObjectsOf am:accesses ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, access can only target passive structure elements."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:accesses $this .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement .
                }
            }
        """ ;
    ] ;
.

## A4: Triggering: BehaviorAspect → BehaviorAspect (core layers)
:TriggeringSourceConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf am:triggers ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, triggering can only originate from behavior elements."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:triggers ?target .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:BehaviorElement .
                }
            }
        """ ;
    ] ;
.

:TriggeringTargetConstraint
    a sh:NodeShape ;
    sh:targetObjectsOf am:triggers ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, triggering can only target behavior elements."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:triggers $this .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:BehaviorElement .
                }
            }
        """ ;
    ] ;
.

## A5: Flow: BehaviorAspect → BehaviorAspect (core layers)
:FlowSourceConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf am:flowsTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, flow can only originate from behavior elements."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:flowsTo ?target .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:BehaviorElement .
                }
            }
        """ ;
    ] ;
.

:FlowTargetConstraint
    a sh:NodeShape ;
    sh:targetObjectsOf am:flowsTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In core layers, flow can only target behavior elements."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:flowsTo $this .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:BehaviorElement .
                }
            }
        """ ;
    ] ;
.


#################################################################
# 5. Serving layer direction — Figures 104/105
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Cross-Layer-Dependencies.html
#################################################################

## A3: Serving should flow upward (lower → higher layer)
:ServingLayerDirectionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:serves ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Serving relationships should flow upward from lower to higher layers (Physical → Technology → Application → Business)."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:serves ?target .
                {
                    $this rdf:type/rdfs:subClassOf* am:BusinessLayerElement .
                    ?target rdf:type/rdfs:subClassOf* am:ApplicationLayerElement .
                } UNION {
                    $this rdf:type/rdfs:subClassOf* am:BusinessLayerElement .
                    ?target rdf:type/rdfs:subClassOf* am:TechnologyLayerElement .
                } UNION {
                    $this rdf:type/rdfs:subClassOf* am:ApplicationLayerElement .
                    ?target rdf:type/rdfs:subClassOf* am:TechnologyLayerElement .
                }
            }
        """ ;
    ] ;
.

#################################################################
# 6. Cross-layer constraints — Section 11.1
#################################################################

## A7: No realization of Business ActiveStructure from App/Tech
:NoRealizationOfBusinessActiveStructureShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:realizes ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Application and Technology elements cannot realize Business active structure elements — only Business behavior can be realized by lower layers."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:realizes ?target .
                ?target rdf:type/rdfs:subClassOf* am:ActiveStructureElement .
                ?target rdf:type/rdfs:subClassOf* am:BusinessLayerElement .
                {
                    $this rdf:type/rdfs:subClassOf* am:ApplicationLayerElement .
                } UNION {
                    $this rdf:type/rdfs:subClassOf* am:TechnologyLayerElement .
                } UNION {
                    $this rdf:type/rdfs:subClassOf* am:PhysicalLayerElement .
                }
            }
        """ ;
    ] ;
.

#################################################################
# 7. Strategy Layer — Figure 46
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Strategy-Layer.html
#################################################################

## A8: Resource assigned to Capability/ValueStream only
:StrategyAssignmentTargetShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Within Strategy layer, Resource can only be assigned to Capability or ValueStream."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:assignedTo ?target .
                $this rdf:type/rdfs:subClassOf* am:StructureElement .
                $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement .
                ?target rdf:type/rdfs:subClassOf* am:StrategyLayerElement .
                FILTER NOT EXISTS {
                    { ?target a am:Capability . }
                    UNION
                    { ?target a am:ValueStream . }
                }
            }
        """ ;
    ] ;
.

## A9: CourseOfAction cannot realize Capability/ValueStream
:StrategyRealizationDirectionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:realizes ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "CourseOfAction should not realize Capability or ValueStream — realization flows the other direction."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:realizes ?target .
                $this a am:CourseOfAction .
                {
                    ?target a am:Capability .
                } UNION {
                    ?target a am:ValueStream .
                }
            }
        """ ;
    ] ;
.

#################################################################
# 8. Core Layer — Figures 52/70/82
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Business-Layer.html
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Application-Layer.html
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Technology-Layer.html
#################################################################

## A10: Interface → Service assignment (same layer)
:CoreInterfaceAssignmentShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Interface assignment target must be an external behavior element (service) in the same layer."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:assignedTo ?target .
                $this rdf:type/rdfs:subClassOf* am:ExternalActiveStructureElement .
                $this rdf:type/rdfs:subClassOf* am:CoreLayerElement .
                VALUES ?layer {
                    am:BusinessLayerElement
                    am:ApplicationLayerElement
                    am:TechnologyLayerElement
                }
                $this rdf:type/rdfs:subClassOf* ?layer .
                FILTER NOT EXISTS {
                    ?target rdf:type/rdfs:subClassOf* am:ExternalBehaviorElement .
                    ?target rdf:type/rdfs:subClassOf* ?layer .
                }
            }
        """ ;
    ] ;
.

## A11: Service should not realize InternalBehavior
:CoreServiceRealizationDirectionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:realizes ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Service should not realize internal behavior — realization flows from process/function toward service."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:realizes ?target .
                $this rdf:type/rdfs:subClassOf* am:ExternalBehaviorElement .
                VALUES ?layer {
                    am:BusinessLayerElement
                    am:ApplicationLayerElement
                    am:TechnologyLayerElement
                }
                $this rdf:type/rdfs:subClassOf* ?layer .
                ?target rdf:type/rdfs:subClassOf* am:BehaviorElement .
                ?target rdf:type/rdfs:subClassOf* ?layer .
                FILTER NOT EXISTS {
                    ?target rdf:type/rdfs:subClassOf* am:ExternalBehaviorElement .
                }
            }
        """ ;
    ] ;
.

#################################################################
# 9. Physical Layer — Figure 99
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Technology-Layer.html
#################################################################

## A12: Physical assignment source must be ActiveStructure
:PhysicalAssignmentSourceShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In Physical layer, assignment can only originate from active structure elements."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:assignedTo ?target .
                $this rdf:type/rdfs:subClassOf* am:PhysicalLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:ActiveStructureElement .
                }
            }
        """ ;
    ] ;
.

## A13: Physical assignment target must be Structure
:PhysicalAssignmentTargetShape
    a sh:NodeShape ;
    sh:targetObjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "In Physical layer, assignment can only target active or passive structure elements."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:assignedTo $this .
                $this rdf:type/rdfs:subClassOf* am:PhysicalLayerElement .
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:ActiveStructureElement .
                }
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement .
                }
            }
        """ ;
    ] ;
.


#################################################################
# 10. Implementation & Migration — Figure 106
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Implementation-and-Migration-Layer.html
#################################################################

## A14: WorkPackage→Deliverable realization deprecated
:DeprecatedWorkPackageRealizesDeliverableShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:realizes ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "WorkPackage → Deliverable realization is deprecated per ArchiMate 3.2 — use an access relationship instead."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:realizes ?target .
                $this a am:WorkPackage .
                ?target a am:Deliverable .
            }
        """ ;
    ] ;
.

## A15: Gap should associate with Plateaus
:GapPlateauAssociationShape
    a sh:NodeShape ;
    sh:targetClass am:Gap ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Gap should be associated with at least one Plateau — a gap represents a difference between two plateaus."@en ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    {
                        $this am:associatedWith ?plateau .
                        ?plateau a am:Plateau .
                    } UNION {
                        ?plateau am:associatedWith $this .
                        ?plateau a am:Plateau .
                    }
                }
            }
        """ ;
    ] ;
.

#################################################################
# 11. Motivation — Figures 34, 45
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Motivation-Elements.html
#################################################################

## A16: Only Business ActiveStructure → Stakeholder assignment
:MotivationAssignmentShape
    a sh:NodeShape ;
    sh:targetObjectsOf am:assignedTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Only Business active structure elements can be assigned to Stakeholder."@en ;
        sh:select """
            SELECT $this ?source WHERE {
                ?source am:assignedTo $this .
                $this a am:Stakeholder .
                FILTER NOT EXISTS {
                    ?source rdf:type/rdfs:subClassOf* am:ActiveStructureElement .
                    ?source rdf:type/rdfs:subClassOf* am:BusinessLayerElement .
                }
            }
        """ ;
    ] ;
.

## A17: Motivation elements — no triggering or flow
:MotivationNoTriggeringShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:triggers ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Motivation elements cannot participate in triggering relationships."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:triggers ?target .
                $this rdf:type/rdfs:subClassOf* am:MotivationElement .
            }
        """ ;
    ] ;
.

:MotivationNoFlowShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:flowsTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Motivation elements cannot participate in flow relationships."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:flowsTo ?target .
                $this rdf:type/rdfs:subClassOf* am:MotivationElement .
            }
        """ ;
    ] ;
.

#################################################################
# 12. Attribute constraints
#################################################################

## A18: Access type — deprecated: the kind of access is the class (am:ReadAccess, …)
:AccessTypeShape
    a sh:NodeShape ;
    sh:targetClass am:Access ;
    sh:property [
        sh:path        am:accessType ;
        sh:maxCount    0 ;
        sh:severity    sh:Warning ;
        sh:message     "am:accessType is deprecated: type the access am:ReadAccess, am:WriteAccess or am:ReadWriteAccess, or leave it am:Access when the kind is unspecified."@en ;
    ] ;
.

## A19: Influence strength validation
:InfluenceStrengthShape
    a sh:NodeShape ;
    sh:targetClass am:Influence ;
    sh:property [
        sh:path        am:influenceStrength ;
        sh:maxCount    1 ;
        sh:datatype    xsd:string ;
        sh:in          ( "+" "++" "-" "--" ) ;
        sh:message     "influenceStrength must be one of: +, ++, -, --."@en ;
    ] ;
.


#################################################################
# 13. Junction validation — Section 5.5
#################################################################

## A20: Junction type must be and/or
:JunctionTypeShape
    a sh:NodeShape ;
    sh:targetClass am:Junction_And ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "All relationships connected to an AndJunction must be of the same type."@en ;
        sh:select """
            SELECT $this WHERE {
                {
                    ?a ?rel1 $this .
                    ?b ?rel2 $this .
                } UNION {
                    $this ?rel1 ?a .
                    $this ?rel2 ?b .
                } UNION {
                    ?a ?rel1 $this .
                    $this ?rel2 ?b .
                }
                ?rel1 rdfs:subPropertyOf* am:composedOf .
                FILTER NOT EXISTS {
                    ?rel2 rdfs:subPropertyOf* am:composedOf .
                }
                FILTER(?rel1 != ?rel2)
            }
        """ ;
    ] ;
.

:OrJunctionTypeShape
    a sh:NodeShape ;
    sh:targetClass am:Junction_Or ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "All relationships connected to an OrJunction must be of the same type."@en ;
        sh:select """
            SELECT $this WHERE {
                {
                    ?a ?rel1 $this .
                    ?b ?rel2 $this .
                } UNION {
                    $this ?rel1 ?a .
                    $this ?rel2 ?b .
                } UNION {
                    ?a ?rel1 $this .
                    $this ?rel2 ?b .
                }
                ?rel1 rdfs:subPropertyOf* am:composedOf .
                FILTER NOT EXISTS {
                    ?rel2 rdfs:subPropertyOf* am:composedOf .
                }
                FILTER(?rel1 != ?rel2)
            }
        """ ;
    ] ;
.


#################################################################
# 14. Motivation realization direction — Figure 45
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Motivation-Elements.html
#################################################################

## A21: Motivation should not realize non-Motivation elements
:MotivationRealizationDirectionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:realizes ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Motivation elements should not realize non-Motivation elements — realization flows from core/strategy toward Motivation."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:realizes ?target .
                $this rdf:type/rdfs:subClassOf* am:MotivationElement .
                FILTER NOT EXISTS {
                    ?target rdf:type/rdfs:subClassOf* am:MotivationElement .
                }
                FILTER NOT EXISTS {
                    ?target a am:Grouping .
                }
            }
        """ ;
    ] ;
.

## A22: Motivation elements — no triggering or flow as target
:MotivationNoTriggeringTargetShape
    a sh:NodeShape ;
    sh:targetObjectsOf am:triggers ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Motivation elements cannot be targets of triggering relationships."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:triggers $this .
                $this rdf:type/rdfs:subClassOf* am:MotivationElement .
            }
        """ ;
    ] ;
.

:MotivationNoFlowTargetShape
    a sh:NodeShape ;
    sh:targetObjectsOf am:flowsTo ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Motivation elements cannot be targets of flow relationships."@en ;
        sh:select """
            SELECT $this WHERE {
                ?source am:flowsTo $this .
                $this rdf:type/rdfs:subClassOf* am:MotivationElement .
            }
        """ ;
    ] ;
.


#################################################################
# 15. Strategy realization target — Figure 51
# Source: https://pubs.opengroup.org/architecture/archimate3-doc/ch-Strategy-Layer.html
#################################################################

## A23: Strategy elements can only realize Strategy or Motivation
:StrategyRealizationTargetShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:realizes ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Strategy elements can only realize other Strategy elements or Motivation elements — not Core layer elements."@en ;
        sh:select """
            SELECT $this ?target WHERE {
                $this am:realizes ?target .
                $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement .
                FILTER NOT EXISTS {
                    ?target rdf:type/rdfs:subClassOf* am:StrategyLayerElement .
                }
                FILTER NOT EXISTS {
                    ?target rdf:type/rdfs:subClassOf* am:MotivationElement .
                }
                FILTER NOT EXISTS {
                    ?target a am:Grouping .
                }
            }
        """ ;
    ] ;
.


#################################################################
# 16. Deep specialization chain — informational
#################################################################

## A24: Warn on deep specialization chains (5+ levels)
:DeepSpecializationChainShape
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:prefixes <https://meta.linked.archi/archimate3/element-shapes#> ;
        sh:message "Element has a deep specialization chain (5+ levels) — consider if this complexity is necessary."@en ;
        sh:select """
            SELECT $this WHERE {
                $this am:specializes+ ?t1 .
                ?t1 am:specializes+ ?t2 .
                ?t2 am:specializes+ ?t3 .
                ?t3 am:specializes+ ?t4 .
            }
        """ ;
    ] ;
.

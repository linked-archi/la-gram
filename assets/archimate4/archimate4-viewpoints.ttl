@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix am4:     <https://meta.linked.archi/archimate4/onto#> .
@prefix :        <https://meta.linked.archi/archimate4/viewpoints#> .

<https://meta.linked.archi/archimate4/viewpoints#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate4/viewpoints#" ;
    vann:preferredNamespacePrefix "am4vp" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi ArchiMate 4.0 Viewpoints"@en ;
    dcterms:description                '''ArchiMate 4.0 viewpoints as arch:Viewpoint individuals.
Each viewpoint specifies allowed element types (arch:includesConcept), target
stakeholders (arch:targetsStakeholder), and framed concerns (arch:viewpointFramesConcern).
ArchiMate 4.0 uses domain-based organization; viewpoints reference the merged
cross-domain elements (Process, Function, Event, Service) from the Common Domain.
Organizations may define additional custom viewpoints.'''@en ;
    dcterms:created               "2026-04-19"^^xsd:date ;
    dcterms:modified              "2026-04-29"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    dcterms:source  <https://pubs.opengroup.org/architecture/archimate4-doc/> ;
    prov:wasDerivedFrom <https://pubs.opengroup.org/architecture/archimate4-doc/> ;
    owl:versionIRI                <https://meta.linked.archi/archimate4/viewpoints/4.0#> ;
    owl:versionInfo               "4.0"@en ;
.


#################################################################
# Viewpoint Catalog (SKOS Concept Scheme)
#
# Classifies ArchiMate 4.0 viewpoints by category. ArchiMate 4.0
# uses domain-based organization; viewpoint categories reflect
# the framework's structural, behavioral, motivational, strategic,
# implementation, and cross-domain dimensions.
#################################################################

:ViewpointCatalog
    a                skos:ConceptScheme ;
    skos:prefLabel   "ArchiMate 4.0 Viewpoint Catalog"@en ;
    dcterms:description  '''Classification of ArchiMate 4.0 viewpoints by category.
The top-level categories correspond to the ArchiMate 4.0 framework dimensions.'''@en ;
    skos:scopeNote   '''This grouping is ArchiMate-specific. Other frameworks use different
organizations — e.g., TOGAF groups viewpoints by ADM phase (A through H).
ISO/IEC/IEEE 42010 does not prescribe a specific grouping.'''@en ;
    skos:hasTopConcept :StructureViewpoints, :BehaviorViewpoints,
                       :MotivationViewpoints, :StrategyViewpoints,
                       :ImplementationViewpoints, :CrossDomainViewpoints ;
.

:StructureViewpoints
    a                 skos:Concept ;
    skos:prefLabel    "Structure Viewpoints"@en ;
    skos:definition   "Viewpoints showing the static structure of the enterprise across domains."@en ;
    skos:topConceptOf :ViewpointCatalog ;
    skos:inScheme     :ViewpointCatalog ;
    skos:narrower     :Organization, :ApplicationStructureVP, :TechnologyVP, :InformationStructureVP ;
.

:BehaviorViewpoints
    a                 skos:Concept ;
    skos:prefLabel    "Behavior Viewpoints"@en ;
    skos:definition   "Viewpoints showing dynamic behavior — processes, cooperation, and service realization."@en ;
    skos:topConceptOf :ViewpointCatalog ;
    skos:inScheme     :ViewpointCatalog ;
    skos:narrower     :ProcessCooperationVP, :ServiceRealizationVP ;
.

:MotivationViewpoints
    a                 skos:Concept ;
    skos:prefLabel    "Motivation Viewpoints"@en ;
    skos:definition   "Viewpoints for modeling motivational aspects — stakeholders, goals, requirements."@en ;
    skos:topConceptOf :ViewpointCatalog ;
    skos:inScheme     :ViewpointCatalog ;
    skos:narrower     :StakeholderVP, :GoalRealization, :RequirementsRealization, :MotivationVP ;
.

:StrategyViewpoints
    a                 skos:Concept ;
    skos:prefLabel    "Strategy Viewpoints"@en ;
    skos:definition   "Viewpoints for strategic direction — capabilities, resources, value streams."@en ;
    skos:topConceptOf :ViewpointCatalog ;
    skos:inScheme     :ViewpointCatalog ;
    skos:narrower     :StrategyVP, :CapabilityMap, :OutcomeRealization, :ResourceMap ;
.

:ImplementationViewpoints
    a                 skos:Concept ;
    skos:prefLabel    "Implementation & Migration Viewpoints"@en ;
    skos:definition   "Viewpoints for managing architecture change — projects, migration, plateaus."@en ;
    skos:topConceptOf :ViewpointCatalog ;
    skos:inScheme     :ViewpointCatalog ;
    skos:narrower     :ImplementationDeploymentVP, :MigrationVP ;
.

:CrossDomainViewpoints
    a                 skos:Concept ;
    skos:prefLabel    "Cross-Domain Viewpoints"@en ;
    skos:definition   "Viewpoints spanning multiple domains, providing an integrated view of the architecture."@en ;
    skos:topConceptOf :ViewpointCatalog ;
    skos:inScheme     :ViewpointCatalog ;
    skos:narrower     :LayeredVP ;
.


#################################################################
# Purpose Individuals
#################################################################

:Deciding    a arch:Purpose ; skos:prefLabel "Deciding"@en ;
    skos:definition "Evaluating options, portfolio rationalization, lifecycle planning, impact analysis."@en .
:Designing   a arch:Purpose ; skos:prefLabel "Designing"@en ;
    skos:definition "Creating or refining architecture — structure, integration, deployment topology."@en .
:Informing   a arch:Purpose ; skos:prefLabel "Informing"@en ;
    skos:definition "Communicating architecture to stakeholders — overviews, landscapes, roadmaps."@en .
:Governing   a arch:Purpose ; skos:prefLabel "Governing"@en ;
    skos:definition "Compliance checking, standards enforcement, migration tracking."@en .


#################################################################
# Stakeholder Individuals
#################################################################

:EnterpriseArchitect     a arch:Stakeholder ; skos:prefLabel "Enterprise Architect"@en .
:SolutionArchitect       a arch:Stakeholder ; skos:prefLabel "Solution Architect"@en .
:BusinessArchitect       a arch:Stakeholder ; skos:prefLabel "Business Architect"@en .
:ApplicationArchitect    a arch:Stakeholder ; skos:prefLabel "Application Architect"@en .
:InfrastructureArchitect a arch:Stakeholder ; skos:prefLabel "Infrastructure Architect"@en .
:SecurityArchitect       a arch:Stakeholder ; skos:prefLabel "Security Architect"@en .
:DataArchitect           a arch:Stakeholder ; skos:prefLabel "Data Architect"@en .
:BusinessManager         a arch:Stakeholder ; skos:prefLabel "Business Manager"@en .
:ProductManager          a arch:Stakeholder ; skos:prefLabel "Product Manager"@en .
:ProcessOwner            a arch:Stakeholder ; skos:prefLabel "Process Owner"@en .
:SoftwareDeveloper       a arch:Stakeholder ; skos:prefLabel "Software Developer"@en .
:OperationsManager       a arch:Stakeholder ; skos:prefLabel "Operations Manager"@en .
:ProjectManager          a arch:Stakeholder ; skos:prefLabel "Project Manager"@en .
:CIO                     a arch:Stakeholder ; skos:prefLabel "CIO"@en .
:CEO                     a arch:Stakeholder ; skos:prefLabel "CEO"@en .


#################################################################
# Structure Viewpoints
#################################################################

:Organization
    a                       arch:Viewpoint ;
    skos:prefLabel          "Organization Viewpoint"@en ;
    skos:definition         '''Shows the structure of the enterprise in terms of its business actors,
roles, collaborations, and their relationships. In ArchiMate 4.0, Role and
Collaboration are Common Domain elements usable across all domains.'''@en ;
    arch:includesConcept    am4:BusinessActor, am4:Role, am4:Collaboration,
                            am4:BusinessInterface, am4:Location ;
    arch:targetsStakeholder :BusinessManager, :BusinessArchitect, :EnterpriseArchitect ;
    arch:viewpointHasPurpose :Informing, :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StructureViewpoints ;
    arch:viewType           arch:Diagram, arch:Catalog ;
.

:ApplicationStructureVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Application Structure Viewpoint"@en ;
    skos:definition         '''Shows the structure of the application landscape in terms of
application components, interfaces, and their relationships.'''@en ;
    arch:includesConcept    am4:ApplicationComponent, am4:ApplicationInterface,
                            am4:DataObject, am4:Collaboration ;
    arch:targetsStakeholder :ApplicationArchitect, :SolutionArchitect, :SoftwareDeveloper ;
    arch:viewpointHasPurpose :Informing, :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StructureViewpoints ;
    arch:viewType           arch:Diagram ;
.

:TechnologyVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Technology Viewpoint"@en ;
    skos:definition         '''Shows the infrastructure and platforms underlying the information
systems, in terms of nodes, devices, system software, networks, equipment,
facilities, and artifacts.'''@en ;
    arch:includesConcept    am4:Node, am4:Device, am4:SystemSoftware, am4:Path,
                            am4:CommunicationNetwork, am4:DistributionNetwork,
                            am4:Equipment, am4:Facility, am4:Artifact,
                            am4:TechnologyInterface, am4:Service ;
    arch:targetsStakeholder :InfrastructureArchitect, :OperationsManager, :SecurityArchitect ;
    arch:viewpointHasPurpose :Informing, :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StructureViewpoints ;
    arch:viewType           arch:Diagram ;
.

:InformationStructureVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Information Structure Viewpoint"@en ;
    skos:definition         '''Shows the structure of the information used in the enterprise,
including business objects, data objects, and their relationships.'''@en ;
    arch:includesConcept    am4:BusinessObject, am4:DataObject, am4:Meaning ;
    arch:targetsStakeholder :DataArchitect, :ApplicationArchitect, :BusinessArchitect ;
    arch:viewpointHasPurpose :Informing, :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StructureViewpoints ;
    arch:viewType           arch:Diagram ;
.


#################################################################
# Behavior Viewpoints
#################################################################

:ProcessCooperationVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Process Cooperation Viewpoint"@en ;
    skos:definition         '''Shows the relationships between processes, including how they
trigger each other, exchange information, and are supported by services.
In ArchiMate 4.0, Process, Function, Event, and Service are cross-domain
Common Domain elements.'''@en ;
    arch:includesConcept    am4:Process, am4:Function, am4:Event,
                            am4:Service, am4:Role, am4:Collaboration,
                            am4:BusinessObject, am4:DataObject,
                            am4:BusinessActor, am4:ApplicationComponent ;
    arch:targetsStakeholder :ProcessOwner, :BusinessArchitect, :BusinessManager ;
    arch:viewpointHasPurpose :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :BehaviorViewpoints ;
    arch:viewType           arch:Diagram ;
.

:ServiceRealizationVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Service Realization Viewpoint"@en ;
    skos:definition         '''Shows how services are realized by processes performed by
roles and active structure elements.'''@en ;
    arch:includesConcept    am4:Service, am4:Process, am4:Function,
                            am4:Role, am4:Collaboration,
                            am4:BusinessActor, am4:ApplicationComponent,
                            am4:BusinessObject, am4:DataObject ;
    arch:targetsStakeholder :BusinessArchitect, :ProcessOwner, :ApplicationArchitect ;
    arch:viewpointHasPurpose :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :BehaviorViewpoints ;
    arch:viewType           arch:Diagram ;
.


#################################################################
# Motivation Viewpoints
#################################################################

:StakeholderVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Stakeholder Viewpoint"@en ;
    skos:definition         '''Shows the stakeholders, their drivers and assessments, and the
goals and principles that address those concerns.'''@en ;
    arch:includesConcept    am4:Stakeholder, am4:Driver, am4:Assessment,
                            am4:Goal, am4:Outcome, am4:Principle,
                            am4:Requirement ;
    arch:targetsStakeholder :EnterpriseArchitect, :BusinessManager, :CIO, :CEO ;
    arch:viewpointHasPurpose :Deciding, :Informing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :MotivationViewpoints ;
    arch:viewType           arch:Diagram, arch:Matrix ;
.

:GoalRealization
    a                       arch:Viewpoint ;
    skos:prefLabel          "Goal Realization Viewpoint"@en ;
    skos:definition         '''Shows how goals are refined into more concrete goals and how
they are realized by requirements.'''@en ;
    arch:includesConcept    am4:Goal, am4:Outcome, am4:Principle,
                            am4:Requirement ;
    arch:targetsStakeholder :EnterpriseArchitect, :BusinessManager ;
    arch:viewpointHasPurpose :Deciding ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :MotivationViewpoints ;
    arch:viewType           arch:Diagram ;
.

:RequirementsRealization
    a                       arch:Viewpoint ;
    skos:prefLabel          "Requirements Realization Viewpoint"@en ;
    skos:definition         '''Shows how requirements are realized by core elements such as
processes, application components, and services.'''@en ;
    arch:includesConcept    am4:Requirement, am4:Goal,
                            am4:Process, am4:Function,
                            am4:Service, am4:ApplicationComponent,
                            am4:DataObject ;
    arch:targetsStakeholder :SolutionArchitect, :ApplicationArchitect, :BusinessArchitect ;
    arch:viewpointHasPurpose :Deciding, :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :MotivationViewpoints ;
    arch:viewType           arch:Diagram, arch:Matrix ;
.

:MotivationVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Motivation Viewpoint"@en ;
    skos:definition         '''Shows the full motivation structure: stakeholders, drivers,
assessments, goals, outcomes, principles, requirements, meanings, and values,
and how they relate to each other.'''@en ;
    arch:includesConcept    am4:Stakeholder, am4:Driver, am4:Assessment,
                            am4:Goal, am4:Outcome, am4:Principle,
                            am4:Requirement, am4:Meaning, am4:Value ;
    arch:targetsStakeholder :EnterpriseArchitect, :CIO, :CEO, :BusinessManager ;
    arch:viewpointHasPurpose :Informing, :Deciding ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :MotivationViewpoints ;
    arch:viewType           arch:Diagram ;
.


#################################################################
# Strategy Viewpoints
#################################################################

:StrategyVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Strategy Viewpoint"@en ;
    skos:definition         '''Shows the strategic direction of the enterprise in terms of
resources, capabilities, value streams, and courses of action, and
how they relate to motivation elements.'''@en ;
    arch:includesConcept    am4:Resource, am4:Capability, am4:ValueStream,
                            am4:CourseOfAction, am4:Goal, am4:Outcome,
                            am4:Principle, am4:Requirement ;
    arch:targetsStakeholder :CEO, :CIO, :EnterpriseArchitect, :BusinessManager ;
    arch:viewpointHasPurpose :Deciding, :Informing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StrategyViewpoints ;
    arch:viewType           arch:Diagram ;
.

:CapabilityMap
    a                       arch:Viewpoint ;
    skos:prefLabel          "Capability Map Viewpoint"@en ;
    skos:definition         '''Shows the capabilities of the enterprise and how they are
composed and related, typically as a hierarchical map.'''@en ;
    arch:includesConcept    am4:Capability, am4:Resource, am4:ValueStream,
                            am4:CourseOfAction, am4:Outcome ;
    arch:targetsStakeholder :EnterpriseArchitect, :CIO, :BusinessManager ;
    arch:viewpointHasPurpose :Deciding, :Informing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StrategyViewpoints ;
    arch:viewType           arch:Diagram, arch:Catalog ;
.

:OutcomeRealization
    a                       arch:Viewpoint ;
    skos:prefLabel          "Outcome Realization Viewpoint"@en ;
    skos:definition         '''Shows how outcomes are realized by capabilities and core
elements, linking strategic intent to operational architecture.'''@en ;
    arch:includesConcept    am4:Outcome, am4:Capability, am4:ValueStream,
                            am4:Process, am4:Function,
                            am4:ApplicationComponent, am4:Value ;
    arch:targetsStakeholder :EnterpriseArchitect, :BusinessManager, :CIO ;
    arch:viewpointHasPurpose :Deciding ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StrategyViewpoints ;
    arch:viewType           arch:Diagram ;
.

:ResourceMap
    a                       arch:Viewpoint ;
    skos:prefLabel          "Resource Map Viewpoint"@en ;
    skos:definition         '''Shows the resources of the enterprise and how they are
assigned to capabilities and realized by core elements.'''@en ;
    arch:includesConcept    am4:Resource, am4:Capability, am4:BusinessActor,
                            am4:Role, am4:ApplicationComponent, am4:Node ;
    arch:targetsStakeholder :EnterpriseArchitect, :BusinessManager, :OperationsManager ;
    arch:viewpointHasPurpose :Deciding, :Informing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :StrategyViewpoints ;
    arch:viewType           arch:Diagram, arch:Catalog ;
.


#################################################################
# Implementation & Migration Viewpoints
#################################################################

:ImplementationDeploymentVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Implementation and Deployment Viewpoint"@en ;
    skos:definition         '''Shows how applications are realized by artifacts and how
artifacts are deployed on technology infrastructure.'''@en ;
    arch:includesConcept    am4:ApplicationComponent, am4:Artifact, am4:Node,
                            am4:Device, am4:SystemSoftware, am4:Path,
                            am4:CommunicationNetwork ;
    arch:targetsStakeholder :InfrastructureArchitect, :SoftwareDeveloper, :OperationsManager ;
    arch:viewpointHasPurpose :Designing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :ImplementationViewpoints ;
    arch:viewType           arch:Diagram ;
.

:MigrationVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Migration Viewpoint"@en ;
    skos:definition         '''Shows the transition from baseline to target architecture
through plateaus and the work packages that implement the transition.
In ArchiMate 4.0, Gap and ImplementationEvent have been removed.'''@en ;
    arch:includesConcept    am4:Plateau, am4:WorkPackage, am4:Deliverable ;
    arch:targetsStakeholder :EnterpriseArchitect, :ProjectManager, :CIO ;
    arch:viewpointHasPurpose :Governing ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :ImplementationViewpoints ;
    arch:viewType           arch:Diagram ;
.


#################################################################
# Cross-Domain Viewpoints
#################################################################

:LayeredVP
    a                       arch:Viewpoint ;
    skos:prefLabel          "Cross-Domain Viewpoint"@en ;
    skos:definition         '''Provides an overview across multiple domains of the architecture,
showing how elements from different domains relate through serving and
realization. In ArchiMate 4.0, this replaces the Layered Viewpoint from 3.x,
reflecting the shift from layers to domains.'''@en ;
    arch:includesConcept    am4:Process, am4:Function, am4:Service,
                            am4:ApplicationComponent, am4:Node,
                            am4:Device, am4:SystemSoftware,
                            am4:BusinessActor, am4:Role ;
    arch:targetsStakeholder :EnterpriseArchitect, :CIO ;
    arch:viewpointHasPurpose :Informing, :Deciding ;
    skos:inScheme           :ViewpointCatalog ;
    skos:broader            :CrossDomainViewpoints ;
    arch:viewType           arch:Diagram ;
.

# ════════════════════════════════════════════════════════════════════
# Unqualified shapes — one per source element class
# Validates direct triples (e.g., ex:A am4:serves ex:B)
# ════════════════════════════════════════════════════════════════════

:ApplicationComponentUnqualifiedShape
    a              sh:NodeShape ;
    sh:targetClass am4:ApplicationComponent ;
    sh:property [
        sh:path am4:accesses ;
        sh:message "ApplicationComponent cannot have access to {$value} — permitted targets: Artifact, BusinessObject, DataObject, Grouping, Material."@en ;
        sh:or (
                [ sh:class am4:Artifact ]
                [ sh:class am4:BusinessObject ]
                [ sh:class am4:DataObject ]
                [ sh:class am4:Grouping ]
                [ sh:class am4:Material ]
        ) ;
    ] ;
    sh:property [
        sh:path am4:aggregates ;
        sh:message "ApplicationComponent cannot have aggregation to {$value} — permitted targets: ApplicationComponent, ApplicationInterface, Grouping."@en ;
        sh:or (
                [ sh:class am4:ApplicationComponent ]
                [ sh:class am4:ApplicationInterface ]
                [ sh:class am4:Grouping ]
        ) ;
    ] ;
    sh:property [
        sh:path am4:assignedTo ;
        sh:message "ApplicationComponent cannot have assignment to {$value} — permitted targets: ApplicationInterface, BusinessInterface, DataObject, Event, Function, Grouping, Process, Role, Service, TechnologyInterface, WorkPackage."@en ;
        sh:or (
                [ sh:class am4:ApplicationInterface ]
                [ sh:class am4:BusinessInterface ]
                [ sh:class am4:DataObject ]
                [ sh:class am4:Event ]
                [ sh:class am4:Function ]
                [ sh:class am4:Grouping ]
                [ sh:class am4:Process ]
                [ sh:class am4:Role ]
                [ sh:class am4:Service ]
                [ sh:class am4:TechnologyInterface ]
                [ sh:class am4:WorkPackage ]
        ) ;
    ] ;
    sh:property [
        sh:path am4:associatedWith ;
        sh:message "ApplicationComponent cannot have association to {$value} — permitted targets: ApplicationComponent, ApplicationInterface, Artifact, Assessment, BusinessActor, BusinessInterface, BusinessObject, Capability, Collaboration, CommunicationNetwork, CourseOfAction, DataObject, Deliverable, Device, DistributionNetwork, Driver, Equipment, Event, Facility, Function, Goal, Grouping, Location, Material, Meaning, Node, Outcome, Path, Plateau, Principle, Process, Product, Relationship, Requirement, Resource, Role, Service, Stakeholder, SystemSoftware, TechnologyInterface, Value, ValueStream, WorkPackage."@en ;
        sh:or (
                [ sh:class am4:ApplicationComponent ]
                [ sh:class am4:ApplicationInterface ]
                [ sh:class am4:Artifact ]
                [ sh:class am4:Assessment ]
                [ sh:class am4:BusinessActor ]

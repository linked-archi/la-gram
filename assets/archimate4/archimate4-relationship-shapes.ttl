                [ sh:class am4:DataObject ]
                [ sh:class am4:Grouping ]
                [ sh:class am4:Material ]
            ) ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class am4:TechnologyInterface ] ]
            [ sh:property [ sh:path arch:target ; sh:or (
                [ sh:class am4:Artifact ]
                [ sh:class am4:BusinessObject ]
                [ sh:class am4:DataObject ]
                [ sh:class am4:Grouping ]
                [ sh:class am4:Material ]
            ) ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class am4:WorkPackage ] ]
            [ sh:property [ sh:path arch:target ; sh:or (
                [ sh:class am4:Deliverable ]
                [ sh:class am4:Grouping ]
            ) ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class am4:AndJunction ] ]
            [ sh:property [ sh:path arch:target ; sh:class arch:ModelConcept ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class arch:ModelConcept ] ]
            [ sh:property [ sh:path arch:target ; sh:class am4:AndJunction ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class am4:OrJunction ] ]
            [ sh:property [ sh:path arch:target ; sh:class arch:ModelConcept ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class arch:ModelConcept ] ]
            [ sh:property [ sh:path arch:target ; sh:class am4:OrJunction ] ]
        ) ]
    ) ;
    sh:message "Access relationship has an invalid source/target combination per the ArchiMate 4.0 specification. Valid sources: ApplicationComponent, ApplicationInterface, BusinessActor, BusinessInterface, Collaboration, CommunicationNetwork, Device, DistributionNetwork, Equipment, Event, Facility, Function, Grouping, Location, Node, Path, Plateau, Process, Product, Role, Service, SystemSoftware, TechnologyInterface, WorkPackage."@en ;
.


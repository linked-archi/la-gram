<https://meta.linked.archi/archimate4/shapes#>
    rdf:type                      owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-shapes#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate4/shapes#" ;
    vann:preferredNamespacePrefix "am4sh" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi ArchiMate 4.0 SHACL Shapes"@en ;
    dcterms:description           '''SHACL shapes for validating ArchiMate 4.0 model data. Generated from the
ArchiMate 4.0 relationship validity matrix (Appendix B), including the relationships
between relationships of Table B-1. Validates qualified relationship instances and
unqualified direct triples. Pure SHACL core.'''@en ;
    dcterms:created               "2026-04-28"^^xsd:date ;
    dcterms:modified              "2026-10-10"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/archimate4/shapes/4.0#> ;
    owl:versionInfo               "4.0"@en ;
    skos:historyNote              '''2026-10-10: generated from the specification's relationship tables
read the right way round — the source along the top, the target down the side. The matrix used before
was transposed and partly guessed, so active structure could be neither assigned to behaviour nor
realize a service (an application component realizing a service, a node assigned to a function), and
pairs such as a process realizing a node were allowed.'''@en ;
.

# ── Access (qualified) — 120 valid pairs ──

:AccessShape
    a              sh:NodeShape ;
    sh:targetClass am4:Access ;
    sh:or (
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class am4:ApplicationComponent ] ]
            [ sh:property [ sh:path arch:target ; sh:or (
                [ sh:class am4:Artifact ]
                [ sh:class am4:BusinessObject ]
                [ sh:class am4:DataObject ]
                [ sh:class am4:Grouping ]
                [ sh:class am4:Material ]
            ) ] ]
        ) ]
        [ sh:and (
            [ sh:property [ sh:path arch:source ; sh:class am4:ApplicationInterface ] ]
            [ sh:property [ sh:path arch:target ; sh:or (
                [ sh:class am4:Artifact ]
                [ sh:class am4:BusinessObject ]

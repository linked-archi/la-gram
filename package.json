{
  "name": "la-gram",
  "version": "0.4.0-alpha",
  "description": "Semantic modeller for enterprise and IT architecture, built on Linked.Archi metamodels",
  "productName": "la-gram",
  "main": "dist/electron/main.cjs",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "build:web": "webpack --mode production --config-name web",
    "build:cli": "webpack --mode production --config-name la-gram-git",
    "build:electron": "webpack --mode production --config-name electron-main --config-name electron-preload --config-name electron-renderer",
    "build:dev": "webpack --mode development",
    "serve": "python3 -m http.server 8080 --directory dist/web",
    "start": "npm run build:dev -- --config-name web && npm run serve",
    "electron": "electron dist/electron/main.cjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:browser": "vitest --run --config vitest.browser.config.ts",
    "test:browser:build": "npm run build:web && npm run test:browser",
    "collab": "node server/collab-server.mjs",
    "dev": "npm run build:dev -- --config-name web && npm run serve",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build:electron && node scripts/package-electron.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:model": "node scripts/bench-model.mjs",
    "docs:setup": "node scripts/docs/run.mjs setup",
    "docs:build": "node scripts/docs/run.mjs build",
    "docs:serve": "node scripts/docs/run.mjs serve",
    "docs:screenshots": "node scripts/docs/screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@linked-archi/kernel": "file:vendor/linked-archi-kernel-0.1.4.tgz",
    "cytoscape": "^3.34.3",
    "d3-force": "3.0.1",
    "diagram-js": "^14.0.0",
    "diagram-js-direct-editing": "^3.5.1",
    "elkjs": "0.12.1",
    "lit": "^3.1.0",
    "n3": "2.13.12",
    "oxigraph": "^0.5.11",
    "rdf-validate-shacl": "^0.5.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/d3-force": "3.0.10",
    "@types/n3": "^1.26.1",
    "@types/rdf-validate-shacl": "^0.5.7",
    "@vitest/coverage-v8": "^4.1.12",
    "copy-webpack-plugin": "14.0.0",
    "electron": "^44.9.0",
    "fast-check": "^3.17.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^28.1.0",
    "playwright": "1.63.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}

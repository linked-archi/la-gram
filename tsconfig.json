{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    // Project root, not `./src`, so `tests/` is inside it and one
    // `tsc --noEmit` type-checks the browser suite alongside the app. Nothing
    // emits through `tsc` — webpack owns the build and decides output paths —
    // so widening `rootDir` changes no artefact.
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["src/ui/*"],
      "@platform/*": ["src/platform/*"],
      "@import-export/*": ["src/import-export/*"]
    },
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
